<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite existing index.html
    RewriteRule ^index\.html$ - [L]

    # Serve existing physical files/folders directly (e.g. sitemap.xml, sitemap-static.xml)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Exclude all sitemap XML files from SPA fallback rewrite
    RewriteCond %{REQUEST_URI} ^/sitemap.*\.xml$ [NC]
    RewriteRule ^ - [L]

    # Serve static Privacy Policy directly without requiring JavaScript
    RewriteRule ^privacy-policy/?$ /privacy-policy.html [L]
    RewriteRule ^user/privacy/?$ /privacy-policy [R=301,L]

    # React Router SPA fallback (Excluding /assets/ and sitemaps so missing hashed JS/CSS chunks or XML sitemaps return 404/XML instead of index.html)
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/sitemap.*\.xml$ [NC]
    RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType application/xml .xml
    AddType text/xml .xml
</IfModule>

<IfModule mod_headers.c>

    # -------------------------------------------------
    # Always serve sitemaps with correct XML header
    # -------------------------------------------------
    <FilesMatch "\.xml$">
        Header set Content-Type "application/xml; charset=UTF-8"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # -------------------------------------------------
    # Never cache index.html and version.json (always fetch latest app shell)
    # -------------------------------------------------
    <FilesMatch "^(index\.html|version\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # -------------------------------------------------
    # Never cache Service Worker
    # -------------------------------------------------
    <Files "firebase-messaging-sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>

    # -------------------------------------------------
    # Cache static assets aggressively
    # (Safe because Vite generates hashed filenames)
    # -------------------------------------------------
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>